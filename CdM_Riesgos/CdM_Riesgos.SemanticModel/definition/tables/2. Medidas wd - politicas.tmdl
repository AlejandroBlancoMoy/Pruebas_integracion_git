	measure Total_empleados =
			
			VAR mes = MONTH(
			MAXX(
			    TOPN(1, VALUES('DW_RIESGOS FAC_HIST_EMPLEADOS'[FE_REGISTRO]), COUNTROWS('DW_RIESGOS FAC_HIST_EMPLEADOS')),
			    'DW_RIESGOS FAC_HIST_EMPLEADOS'[FE_REGISTRO]
			))
			return IF(ISBLANK(
			    CALCULATE(
			    COUNTROWS('DW_RIESGOS FAC_HIST_EMPLEADOS'),
			    FILTER('DW_RIESGOS FAC_HIST_EMPLEADOS',
			  MONTH( 'DW_RIESGOS FAC_HIST_EMPLEADOS'[FE_REGISTRO]) = mes))),0,
			CALCULATE(
			    COUNTROWS('DW_RIESGOS FAC_HIST_EMPLEADOS'),
			    FILTER('DW_RIESGOS FAC_HIST_EMPLEADOS',
			  MONTH( 'DW_RIESGOS FAC_HIST_EMPLEADOS'[FE_REGISTRO])= mes))
			)
		formatString: #,0
		lineageTag: 55450995-07e4-4c23-a110-fb93bfef6449

		changedProperty = FormatString

	measure %Aceptacion_codigo_conducta =
			
			DIVIDE(
