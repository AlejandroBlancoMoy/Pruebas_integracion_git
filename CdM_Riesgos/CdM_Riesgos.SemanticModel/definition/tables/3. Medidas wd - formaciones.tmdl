	measure FM_Aceptacion_codigo_conducta_v2 =
			
			VAR mes = MONTH(
			MAXX(
			    TOPN(1, VALUES('DW_RIESGOS FAC_CURSOS'[FE_CURSO]), COUNTROWS('DW_RIESGOS FAC_CURSOS')),
			    'DW_RIESGOS FAC_CURSOS'[FE_CURSO]
			))
			return IF(ISBLANK(
			    CALCULATE(
			    COUNTROWS('DW_RIESGOS FAC_CURSOS'),
			    FILTER('DW_RIESGOS FAC_CURSOS',
			   'DW_RIESGOS FAC_CURSOS'[DS_CURSO_CODIGO_CONDUCTA] = "Si" && MONTH( 'DW_RIESGOS FAC_CURSOS'[FE_CURSO]) = mes))),0,
			CALCULATE(
			    COUNTROWS('DW_RIESGOS FAC_CURSOS'),
			    FILTER('DW_RIESGOS FAC_CURSOS',
			   'DW_RIESGOS FAC_CURSOS'[DS_CURSO_CODIGO_CONDUCTA] = "Si" && MONTH( 'DW_RIESGOS FAC_CURSOS'[FE_CURSO]) = mes))
			)
		formatString: 0
		lineageTag: 40b48462-be5b-4226-9b52-29c89719c107

